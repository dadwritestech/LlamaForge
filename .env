# ---------------------------------------------------------------------------
# LlamaForge - Dockhand environment config
# ---------------------------------------------------------------------------

# ---- Image / build -----------------------------------------------------
# GPU host (default): needs an NVIDIA GPU + NVIDIA Container Toolkit.
# CPU-only host (e.g. a Bazzite box with no discrete GPU): change to
# ubuntu:22.04 and set ENABLE_CUDA=false below, and delete the "deploy"
# block in docker-compose.yaml.
DOCKER_BASE_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
LLAMAFORGE_REPO=https://github.com/CaspervanWetten/LlamaForge.git
LLAMAFORGE_REF=master

# ---- Ports (host side) --------------------------------------------------
DASHBOARD_PORT=8090
ROUTER_PORT=8080

# ---- llama.cpp build -----------------------------------------------------
# Set to false on a CPU-only host/base image.
ENABLE_CUDA=true
# Builds llama-server automatically on first boot if missing. Set to false
# to build it yourself later from the dashboard's Build tab instead.
AUTO_BUILD_LLAMACPP=true
GIT_REMOTE_LLAMACPP=https://github.com/ggml-org/llama.cpp

# ---- Router (llama.cpp API) ----------------------------------------------
# Leave as 0.0.0.0 so the container port mapping can reach it.
ROUTER_HOST=0.0.0.0
# Strongly recommended once ROUTER_HOST isn't loopback-only - set a key here.
ROUTER_API_KEY=

# ---- Models ---------------------------------------------------------------
# Comma-separated directories INSIDE the container to scan for GGUF models.
# /data/models lives on the llamaforge-data volume by default.
MODEL_DIRS=/data/models
AUTO_LOAD_MODEL=

# ---- Dashboard misc ---------------------------------------------------
UI_MODE=advanced
THEME=
CVD=false
ANTHROPIC_SHIM_ENABLED=false
ANTHROPIC_DEFAULT_MODEL=

# Note: these env vars only seed config.json on the container's very first
# boot (when the llamaforge-data volume is created). After that, LlamaForge's
# own dashboard owns config.json, same as it would running natively - change
# settings there, not here, on subsequent deploys.
